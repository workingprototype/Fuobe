{
  "name": "fuobe",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "fuobe": "bin/fuobe.mjs"
  },
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e:comfyui": "node tests/e2e/comfyui-selftest.mjs",
    "test:e2e:library": "node tests/e2e/library-flows.mjs",
    "test:e2e:mobile": "node tests/e2e/no-horizontal-scroll.mjs",
    "test:e2e:shell": "node tests/e2e/shell.mjs",
    "gen:catalog": "python3 scripts/gen-cloud-models.py && python3 scripts/gen-higgsfield-models.py && python3 scripts/gen-higgsfield-presets.py && python3 scripts/gen-oss-loras.py && node scripts/gen-icon-map.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fal-ai/client": "^1.10.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@google/model-viewer": "4.3.1",
    "@tanstack/react-query": "^5.104.3",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.58.0",
    "meshoptimizer": "1.2.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "playwright-core": "1.64.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "three": "0.183.2",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0"
