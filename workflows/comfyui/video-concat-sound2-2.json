      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": {
      "title": "Clip 2 at the film's frame rate (its sound is the soundtrack)"
    }
  },
  "5": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "4",
        0
      ],
      "upscale_method": "lanczos",
      "width": 640,
      "height": 640,
      "crop": "center"
    },
    "_meta": {
      "title": "Fit clip 2"
    }
  },
  "20": {
