{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None",
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Clip, decoded framesPerBatch frames per pass"
    }
  },
  "2": {
    "class_type": "VHS_BatchManager",
    "inputs": {
      "frames_per_batch": 16
    },
    "_meta": {
      "title": "Meta batch: re-queue every framesPerBatch frames (memory stays flat)"
    }
  },
  "3": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "RealESRGAN_x4plus.safetensors"
    },
    "_meta": {
      "title": "Upscale model (upscaleModel)"
    }
  },
  "4": {
    "class_type": "ImageUpscaleWithModel",
    "inputs": {
      "upscale_model": [
        "3",
        0
      ],
      "image": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Upscale this pass's frames (tiled)"
    }
  },
  "5": {
    "class_type": "ResizeImageMaskNode",
    "inputs": {
      "input": [
        "4",
        0
      ],
      "resize_type": "scale shorter dimension",
      "resize_type.shorter_size": 1080,
      "scale_method": "lanczos"
    },
    "_meta": {
      "title": "To the target size: the shorter edge becomes shortSide px (1080 for 1080p), the shape is kept"
    }
  },
  "6": {
    "class_type": "VHS_VideoInfo",
    "inputs": {
      "video_info": [
        "1",
        3
      ]
    },
    "_meta": {
      "title": "Source frame rate"
    }
  },
  "7": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "5",
        0
      ],
      "audio": [
        "1",
        2
      ],
      "frame_rate": [
        "6",
        5
      ],
      "loop_count": 0,
      "filename_prefix": "fuobe/upscale-video-esrgan-chunked",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 17,
      "save_metadata": true,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Encode as the passes come (the last pass writes the file, with the source's sound)"
    }
  }
}
