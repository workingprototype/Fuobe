{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": {
      "title": "Video (its picture is copied, never decoded)"
    }
  },
  "3": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "soundtrack.wav"
    },
    "_meta": {
      "title": "New soundtrack (audio)"
    }
  },
  "7": {
    "class_type": "ConcatenateVideo",
    "inputs": {
      "videos.video0": [
        "1",
        0
      ],
      "codec": "auto",
      "complete_audio": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Same picture, new soundtrack (stream copy)"
    }
  },
  "8": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "7",
        0
      ],
      "filename_prefix": "fuobe/video-mux-audio-replace",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
