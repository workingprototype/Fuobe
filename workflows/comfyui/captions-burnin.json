{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": {
      "title": "Video to caption"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {
      "title": "Soundtrack + fps of the whole clip"
    }
  },
  "10": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0,
      "duration": 0.5,
      "strict_duration": false
    },
    "_meta": {
      "title": "Caption segment 1 (the app writes one per cue)"
    }
  },
  "11": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "10",
        0
      ]
    },
    "_meta": {
      "title": "Segment 1 frames"
    }
  },
  "12": {
    "class_type": "TextOverlay",
    "inputs": {
      "images": [
        "11",
        0
      ],
      "text": "Fuobe captions",
      "font_size": 6,
      "color": "#ffffff",
      "position": "bottom",
      "align": "center",
      "outline": true
    },
    "_meta": {
      "title": "Caption style (copied to every cue)"
    }
  },
  "20": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.5,
      "duration": 0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Caption segment 2 (to the end)"
    }
  },
  "21": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "20",
        0
      ]
    },
    "_meta": {
      "title": "Segment 2 frames"
    }
  },
  "22": {
    "class_type": "TextOverlay",
    "inputs": {
      "images": [
        "21",
        0
      ],
      "text": "burned into the frames",
      "font_size": 6,
      "color": "#ffffff",
      "position": "bottom",
      "align": "center",
      "outline": true
    },
    "_meta": {
      "title": "Caption 2"
    }
  },
  "90": {
    "class_type": "BatchImagesNode",
    "inputs": {
      "images.image0": [
        "12",
        0
      ],
      "images.image1": [
        "22",
        0
      ]
    },
    "_meta": {
      "title": "Segments in order"
    }
  },
  "91": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "90",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "audio": [
        "2",
        1
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {
      "title": "Captioned video (source fps + audio)"
    }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "91",
        0
      ],
      "filename_prefix": "fuobe/captions-burnin",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
