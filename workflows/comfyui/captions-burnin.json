{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input.mp4"
    },
    "_meta": {
      "title": "Video to caption"
    }
  },
  "3": {
    "class_type": "LoadAudio",
    "inputs": {
      "audio": "input.mp4"
    },
    "_meta": {
      "title": "Its soundtrack, laid under the result (dropped for silent clips)"
    }
  },
  "10": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0,
      "duration": 0.5,
      "strict_duration": false
    },
    "_meta": {
      "title": "Captioned chunk 1 (the app writes one chunk per cue piece)"
    }
  },
  "11": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "10",
        0
      ]
    },
    "_meta": {
      "title": "Chunk 1 frames (only this chunk is decoded)"
    }
  },
  "12": {
    "class_type": "TextOverlay",
    "inputs": {
      "images": [
        "11",
        0
      ],
      "text": "Fuobe captions",
      "font_size": 6,
      "color": "#ffffff",
      "position": "bottom",
      "align": "center",
      "outline": true
    },
    "_meta": {
      "title": "Caption style (copied to every chunk)"
    }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "12",
        0
      ],
      "fps": [
        "11",
        2
      ],
      "audio": [
        "11",
        1
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "h264"
    },
    "_meta": {
      "title": "Chunk 1 encoded right away (its frames can leave memory)"
    }
  },
  "20": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.5,
      "duration": 0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Gap without a caption (never decoded here)"
    }
  },
  "90": {
    "class_type": "ConcatenateVideo",
    "inputs": {
      "videos.video0": [
        "13",
        0
      ],
      "videos.video1": [
        "20",
        0
      ],
      "codec": "auto",
      "complete_audio": [
        "3",
        0
      ]
    },
    "_meta": {
      "title": "Chunks and gaps in order, with the clip's soundtrack"
    }
  },
  "92": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "90",
        0
      ],
      "filename_prefix": "fuobe/captions-burnin",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
