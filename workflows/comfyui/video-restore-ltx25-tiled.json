{
  "canvas": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "field",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1440,
      "height": 1088,
      "crop": "disabled"
    },
    "_meta": {
      "title": "lanczos to the working canvas (1440 wide for 4:3, 1920x1088 for 16:9; the shape kept, multiples of 32): the guide never sees the small scan"
    }
  },
  "conditioning": {
    "class_type": "LTXVConditioning",
    "inputs": {
      "positive": [
        "positive",
        0
      ],
      "negative": [
        "negative",
        0
      ],
      "frame_rate": 24
    },
    "_meta": {
      "title": "the clip's own frame rate"
    }
  },
  "decode": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    },
    "_meta": {
      "title": "tiled decode"
    }
  },
  "empty": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": {
      "width": 1440,
      "height": 1088,
      "length": 97,
      "batch_size": 1
    },
    "_meta": {
      "title": "the canvas, the window's frames (8n+1)"
    }
  },
  "field": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "source",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": 640,
      "height": 240,
      "crop": "disabled"
    },
    "_meta": {
      "title": "deinterlace (optional): one field, every other row (nearest, no blending); the canvas resize rebuilds the height. The provider removes it when off"
    }
  },
  "guide": {
    "class_type": "LTXAddVideoICLoRAGuide",
    "inputs": {
      "positive": [
        "conditioning",
        0
      ],
      "negative": [
        "conditioning",
        1
      ],
      "vae": [
        "vae",
        0
      ],
      "latent": [
        "empty",
        0
      ],
      "image": [
        "canvas",
        0
      ],
      "frame_idx": 0,
      "strength": 1,
      "latent_downscale_factor": [
        "lora",
        1
      ],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64,
      "use_streaming": false,
      "tile_frames": 97
    },
    "_meta": {
      "title": "the archive clip as the frame-aligned IC-LoRA reference (downscale 1, untiled encode); use_streaming only for a whole clip past 97 frames"
    }
  },
  "keep": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "decode",
        0
      ],
      "batch_index": 0,
      "length": 4096
    },
    "_meta": {
      "title": "the window's own frames: from prefixFrames on (the prefix the window before already made is dropped)"
    }
  },
  "lora": {
    "class_type": "LTXICLoRALoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "ltx-2.5-22b-ic-lora-restore-1.0.safetensors",
      "strength_model": 1
    },
    "_meta": {
      "title": "the Restore IC-LoRA at 1.0 (a switch: 0.7 stays monochrome, 1.4 over-tints); the Detail Refine IC-LoRA for stage 2. Its latent_downscale_factor (1) feeds the guides"
    }
  },
  "negative": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "modern cars, modern buildings, shipping containers, logos, signage, lettering, graffiti, blocky compression, banding, mosquito noise, ringing, blurry, smeared, ghosting, low resolution",
      "clip": [
        "text",
        0
      ]
    },
    "_meta": {
      "title": "what it must not invent, and the damage"
    }
  },
  "positive": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a steam locomotive arriving at a small rural railway station in 1896, passengers in period coats and hats waiting on the platform, wooden station buildings, natural colour",
      "clip": [
        "text",
        0
      ]
    },
    "_meta": {
      "title": "period, place, light, materials, clothing, natural colour"
    }
  },
  "prefix": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": [
        "guide",
        0
      ],
      "negative": [
        "guide",
        1
      ],
      "vae": [
        "vae",
        0
      ],
      "latent": [
        "guide",
        2
      ],
      "image": [
        "prefix_source",
        0
      ],
      "frame_idx": 0,
      "strength": 1
    },
    "_meta": {
      "title": "prefix at frame 0: the model continues from the restored frames, so colour holds across windows"
    }
  },
  "prefix_source": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "previous_window.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 17,
      "skip_first_frames": 80,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": {
      "title": "the window before's last 17 restored frames (prefix hand-off); the provider removes this branch on the first window"
    }
  },
  "reference": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "reference.png"
    },
    "_meta": {
      "title": "reference picture (optional): native crops of faces, signs or true colours on grey, or a colour photo framed like the clip"
    }
  },
  "reference_fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "reference",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1440,
      "height": 1088,
      "crop": "center"
    },
    "_meta": {
      "title": "the reference on the canvas (it is cropped per tile like the clip)"
    }
  },
  "reference_guide": {
    "class_type": "LTXAddVideoICLoRAGuide",
    "inputs": {
      "positive": [
        "prefix",
        0
      ],
      "negative": [
        "prefix",
        1
      ],
      "vae": [
        "vae",
        0
      ],
      "latent": [
        "prefix",
        2
      ],
      "image": [
        "reference_fit",
        0
      ],
      "frame_idx": -1,
      "strength": 1,
      "latent_downscale_factor": [
        "lora",
        1
      ],
      "crop": "disabled",
      "use_tiled_encode": false,
      "tile_size": 256,
      "tile_overlap": 64,
      "use_streaming": false,
      "tile_frames": 97
    },
    "_meta": {
      "title": "a second IC-LoRA guide at frame_idx -1 (before the clip, not in its first slot); the provider removes this branch without a reference"
    }
  },
  "sample": {
    "class_type": "LTXVTiledFusionSampler",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "positive": [
        "reference_guide",
        0
      ],
      "negative": [
        "reference_guide",
        1
      ],
      "latents": [
        "reference_guide",
        2
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "sampler": [
        "sampler_select",
        0
      ],
      "seed": 42,
      "cfg": 1,
      "tile_width": 960,
      "tile_height": 544,
      "overlap_frac": 0.5,
      "blend_var": 0.05,
      "grid_cycle": 1,
      "tile_frames": 0,
      "vae": [
        "vae",
        0
      ],
      "canvas_device": "auto"
    },
    "_meta": {
      "title": "per-step tiled latent fusion: 960x544 tiles at 50% overlap (1024x576 for stage 2), guidance 1.0; tile_frames 97 only with a streaming guide"
    }
  },
  "sampler_select": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    },
    "_meta": {
      "title": "euler (fusion owns the sigma loop)"
    }
  },
  "save": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "video",
        0
      ],
      "filename_prefix": "fuobe/video-restore-ltx25-tiled",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "SaveVideo"
    }
  },
  "sigmas": {
    "class_type": "ManualSigmas",
    "inputs": {
      "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
    },
    "_meta": {
      "title": "the card's 8 distilled steps"
    }
  },
  "source": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "archive.mp4",
      "force_rate": 0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 97,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "None"
    },
    "_meta": {
      "title": "the window: frame_load_cap frames from skip_first_frames, at the clip's own rate (no resample, no 8n+1 cut: the plan's windows are 8n+1)"
    }
  },
  "text": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    },
    "_meta": {
      "title": "Gemma 4 12B text encoder"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "LTX-2.5 22B distilled"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
    },
    "_meta": {
      "title": "LTX-2.5 video VAE"
    }
  },
  "video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "keep",
        0
      ],
      "fps": 24,
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {
      "title": "silent: the pipeline puts the clip's own sound back after the join"
    }
  }
}
