# Metrics for the evaluation harness (scripts/eval). Top-level choices with their licences;
# requirements.txt is the full pinned set, compiled from this file:
#   uv pip compile requirements.in --torch-backend cpu --python-version 3.12 -o requirements.txt
# pnpm eval:setup installs it into scripts/eval/metrics/.venv (git-ignored).
