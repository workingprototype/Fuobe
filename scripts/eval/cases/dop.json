{
  "$schema": "./case.schema.json",
  "suite": "dop",
  "title": "Fuobe DoP · camera motions and effects with LoRAs",
  "description": "Generated by scripts/eval/gen-cases.mjs from the research files; edit the generator, not this file. Every motion and effect the research gives a LoRA (§7.2) and the catalog already has, on your start frame (local/dop/start.png, plus local/dop/end.png for transitions; a photo of a person on a bridge matches the prompt). Variants: the catalog preset as it ships, its prompt without LoRAs (preset strength 0), and the research's LoRA map v2 on the same prompt. The cloud Original (fuobe-dop on fal's Wan 2.2 LoRA endpoint) arrives with O4; the partner variant runs the preset's words on Kling 2.5 Turbo. Not in the catalog yet: none.",
  "original": [
    "fuobe-dop",
    "fuobe-dop-ltx"
  ],
  "kind": "video",
  "recipe": "motion",
  "targets": {
    "open": {
      "models": [
        "oss-wan22-14b"
      ],
      "params": {
        "duration": 5
      }
    },
    "cloud": {
      "models": [
        "fuobe-dop"
      ],
      "params": {
        "duration": 5
      }
    },
    "demo": {
      "models": [
        "oss-wan22-14b"
      ],
      "params": {
        "duration": 5
      }
    }
  },
  "defaults": {
    "seeds": [
      1001,
      2002
    ],
    "prompts": [
      {
        "id": "bridge",
        "text": "a woman in a red coat on a city bridge at golden hour"
      }
    ],
    "metrics": [
      "temporal",
      "clip"
    ],
    "variant": "catalog",
    "candidate": "research",
    "timeoutSeconds": 2700
  },
  "variants": {
    "catalog": {
      "description": "The catalog preset as it ships (prompt template + today's LoRA map)"
    },
    "prompt-only": {
      "description": "The preset's prompt without LoRAs (preset strength 0)",
      "presetStrength": 0
    },
    "research": {
      "description": "The research's LoRA map v2 at the listed strengths on the preset's prompt",
      "presetStrength": 0,
      "loras": "recipe"
    },
    "partner": {
      "description": "The preset's words on a partner model (Kling 2.5 Turbo), for reference",
      "models": {
        "cloud": [
          "kling-2-5-turbo"
        ]
      },
      "engines": [
        "cloud"
      ]
    }
  },
