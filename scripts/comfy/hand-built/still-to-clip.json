{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "card.png"
    },
    "_meta": {
      "title": "Still or end card (image)"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1280,
      "height": 720,
      "crop": "center"
    },
    "_meta": {
      "title": "To the clip size (width, height; centre crop)"
    }
  },
  "3": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 3
    },
    "_meta": {
      "title": "Seconds (duration)"
    }
  },
  "4": {
    "class_type": "PrimitiveFloat",
    "inputs": {
      "value": 30
    },
    "_meta": {
      "title": "Frames per second (fps)"
    }
  },
  "5": {
    "class_type": "ComfyMathExpression",
    "inputs": {
      "expression": "max(round(a * b), 1)",
      "values.a": [
        "3",
        0
      ],
      "values.b": [
        "4",
        0
      ]
    },
    "_meta": {
      "title": "Frame count"
    }
  },
  "6": {
    "class_type": "RepeatImageBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "amount": [
        "5",
        1
      ]
    },
    "_meta": {
      "title": "Hold the still"
    }
  },
  "7": {
    "class_type": "EmptyAudio",
    "inputs": {
      "duration": [
        "3",
        0
      ],
      "sample_rate": 44100,
      "channels": 2
    },
    "_meta": {
      "title": "Silent soundtrack (so joins and players see an audio track)"
    }
  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "fps": [
        "4",
        0
      ],
      "audio": [
        "7",
        0
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "h264"
    },
    "_meta": {
      "title": "Clip (encoded right away)"
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "8",
        0
      ],
      "filename_prefix": "fuobe/still-to-clip",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
}
