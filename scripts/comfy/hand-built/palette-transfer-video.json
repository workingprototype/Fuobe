{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input_video.mp4"
    },
    "_meta": {
      "title": "Source clip"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {}
  },
  "3": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "palette_swatch.png"
    },
    "_meta": {
      "title": "Palette swatch (image)"
    }
  },
  "4": {
    "class_type": "ColorTransfer",
    "inputs": {
      "image_target": [
        "2",
        0
      ],
      "image_ref": [
        "3",
        0
      ],
      "method": "mkl_lab",
      "source_stats": "uniform",
      "strength": 0.8
    },
    "_meta": {
      "title": "Color transfer (uniform stats = no flicker)"
    }
  },
  "5": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "audio": [
        "2",
        1
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {}
  },
  "6": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "5",
        0
      ],
      "filename_prefix": "fuobe/palette-transfer-video",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save video"
    }
  }
