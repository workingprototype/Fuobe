{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": ["5", 0],
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": ["7", 1],
      "skip_first_frames": ["6", 1],
      "select_every_nth": 1,
      "format": "None",
      "meta_batch": ["2", 0]
    },
    "_meta": { "title": "Clip at the film's frame rate, from startTime for duration seconds (0 = to the end), framesPerBatch frames per pass" }
  },
  "2": {
    "class_type": "VHS_BatchManager",
    "inputs": { "frames_per_batch": 64 },
    "_meta": { "title": "Meta batch: re-queue every framesPerBatch frames (memory stays flat)" }
  },
  "3": {
    "class_type": "ImageScale",
    "inputs": { "image": ["1", 0], "upscale_method": "lanczos", "width": 1280, "height": 720, "crop": "center" },
    "_meta": { "title": "Into the film's frame: scaled to cover, centre-cropped" }
  },
  "4": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["3", 0],
      "audio": ["1", 2],
      "frame_rate": ["5", 0],
      "loop_count": 0,
      "filename_prefix": "fuobe/video-fit-clip",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "trim_to_audio": false,
      "pingpong": false,
      "save_output": true,
      "meta_batch": ["2", 0]
    },
    "_meta": { "title": "H.264 + the window's sound (the provider swaps in silence for a muted or silent clip)" }
  },
  "5": {
    "class_type": "PrimitiveFloat",
    "inputs": { "value": 30 },
    "_meta": { "title": "fps" }
  },
  "6": {
    "class_type": "ComfyMathExpression",
    "inputs": { "expression": "round(a * b)", "values.a": ["8", 0], "values.b": ["5", 0] },
    "_meta": { "title": "Frames to skip: startTime x fps" }
  },
  "7": {
    "class_type": "ComfyMathExpression",
    "inputs": { "expression": "round(a * b)", "values.a": ["9", 0], "values.b": ["5", 0] },
    "_meta": { "title": "Frames to keep: duration x fps (0 = to the end)" }
  },
  "8": {
    "class_type": "PrimitiveFloat",
    "inputs": { "value": 0 },
    "_meta": { "title": "startTime (s)" }
  },
  "9": {
    "class_type": "PrimitiveFloat",
    "inputs": { "value": 0 },
    "_meta": { "title": "duration (s, 0 = to the end)" }
  }
}
