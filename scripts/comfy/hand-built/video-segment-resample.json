{
  "1": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "input.mp4",
      "force_rate": 16,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 81,
      "skip_first_frames": 0,
      "select_every_nth": 1,
      "format": "Wan"
    },
    "_meta": {
      "title": "VHS_LoadVideo"
    }
  },
  "2": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "width": 832,
      "height": 480,
      "crop": "center"
    },
    "_meta": {
      "title": "ImageScale"
    }
  },
  "3": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "2",
        0
      ],
      "fps": 16.0,
      "audio": [
        "1",
        2
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {
      "title": "CreateVideo"
    }
  },
  "4": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "3",
        0
      ],
      "filename_prefix": "fuobe/video-segment-resample",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "SaveVideo"
    }
  },
  "5": {
    "class_type": "GetImageSizeAndCount",
    "inputs": {
      "image": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "GetImageSizeAndCount"
    }
  },
  "6": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "2",
        0
      ],
      "batch_index": 0,
      "length": 1
    },
    "_meta": {
      "title": "ImageFromBatch"
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "6",
        0
      ],
      "filename_prefix": "fuobe/video-segment-resample-first"
    },
    "_meta": {
      "title": "SaveImage"
    }
  }
