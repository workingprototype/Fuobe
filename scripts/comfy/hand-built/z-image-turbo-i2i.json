{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Picture to restyle (image)"
    }
  },
  "2": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 1.0,
      "resolution_steps": 16
    },
    "_meta": {
      "title": "Soul's tier: about 1 MP (720p) or 2 MP (1080p), sides on the 16-pixel grid"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "z_image_turbo_bf16.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "UNETLoader"
    }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "lumina2",
      "device": "default"
    },
    "_meta": {
      "title": "CLIPLoader"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    },
    "_meta": {
      "title": "VAELoader"
    }
  },
  "13": {
    "class_type": "ModelSamplingAuraFlow",
    "inputs": {
      "model": [
        "10",
        0
      ],
      "shift": 3.0,
      "sampling": "flow"
    },
    "_meta": {
      "title": "ModelSamplingAuraFlow"
    }
  },
  "14": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "11",
        0
      ],
      "text": "The same photo restyled: soft daylight, natural skin texture"
    },
    "_meta": {
      "title": "Prompt (the look around the user's words)"
    }
  },
  "15": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "14",
        0
      ]
    },
    "_meta": {
      "title": "ConditioningZeroOut (cfg 1)"
    }
  },
  "16": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "VAEEncode"
    }
  },
  "17": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "13",
        0
      ],
      "positive": [
        "14",
        0
      ],
      "negative": [
        "15",
        0
      ],
      "latent_image": [
        "16",
        0
      ],
      "seed": 0,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": 0.6
    },
    "_meta": {
      "title": "KSampler (denoise = how much the look changes the picture)"
    }
  },
  "18": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "17",
        0
      ],
      "vae": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "VAEDecode"
    }
  },
  "19": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "18",
        0
      ],
      "filename_prefix": "fuobe/z-image-turbo-i2i"
    },
    "_meta": {
      "title": "SaveImage"
    }
  }
}
