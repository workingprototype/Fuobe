{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "input_video.mp4"
    },
    "_meta": {
      "title": "Source clip"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    },
    "_meta": {}
  },
  "3": {
    "class_type": "LoadVideoDepthAnythingModel",
    "inputs": {
      "model": "video_depth_anything_vits.pth"
    },
    "_meta": {}
  },
  "4": {
    "class_type": "VideoDepthAnythingProcess",
    "inputs": {
      "vda_model": [
        "3",
        0
      ],
      "images": [
        "2",
        0
      ],
      "input_size": 518,
      "max_res": 1280,
      "precision": "fp16"
    },
    "_meta": {}
  },
  "5": {
    "class_type": "VideoDepthAnythingOutput",
    "inputs": {
      "depths": [
        "4",
        0
      ],
      "colormap": "gray"
    },
    "_meta": {
      "title": "Colour map (colormap: gray | inferno)"
    }
  },
  "6": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "10",
        0
      ],
      "fps": [
        "2",
        2
      ],
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    },
    "_meta": {}
  },
  "7": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "6",
        0
      ],
      "filename_prefix": "fuobe/video-depth-vda",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save depth video"
    }
  },
  "8": {
    "class_type": "ImageStitch",
    "inputs": {
      "image1": [
        "2",
        0
      ],
      "image2": [
        "12",
        0
      ],
      "direction": "right",
      "match_image_size": false,
      "spacing_width": 0,
      "spacing_color": "black"
    },
    "_meta": {
      "title": "Original | depth"
    }
  },
  "9": {
    "class_type": "PrimitiveBoolean",
    "inputs": {
      "value": false
    },
    "_meta": {
      "title": "Side by side (sideBySide)"
    }
  },
  "10": {
    "class_type": "ComfySwitchNode",
    "inputs": {
      "switch": [
        "9",
        0
      ],
      "on_true": [
        "8",
        0
      ],
      "on_false": [
        "5",
        0
      ]
    },
    "_meta": {
      "title": "Depth alone, or next to the original"
    }
  },
  "11": {
    "class_type": "GetImageSize",
    "inputs": {
      "image": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "The clip's size"
    }
  },
  "12": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "lanczos",
      "width": [
        "11",
        0
      ],
      "height": [
        "11",
        1
      ],
      "crop": "disabled"
    },
    "_meta": {
      "title": "Depth at the clip's size (an even total width for the encoder)"
    }
  }
}
