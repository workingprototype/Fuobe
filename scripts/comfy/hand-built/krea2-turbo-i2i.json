{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "input.png"
    },
    "_meta": {
      "title": "Picture to redraw (image)"
    }
  },
  "2": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "1",
        0
      ],
      "upscale_method": "lanczos",
      "megapixels": 2,
      "resolution_steps": 16
    },
    "_meta": {
      "title": "About 2 MP (Krea 2's size), sides on the 16-pixel grid"
    }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "10",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "13",
        0
      ],
      "latent_image": [
        "16",
        0
      ],
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.6
    },
    "_meta": {
      "title": "KSampler (denoise = how much the picture changes)"
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "11",
        0
      ],
      "text": "The same photo with natural skin texture and soft daylight."
    },
    "_meta": {
      "title": "CLIP Text Encode (Prompt)"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "3",
        0
      ],
      "vae": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "10": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "krea2_turbo_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model (Krea 2 Turbo)"
    }
  },
  "11": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_fp8_scaled.safetensors",
      "type": "krea2",
      "device": "default"
    },
    "_meta": {
      "title": "Load CLIP (Qwen3-VL 4B, krea2)"
    }
  },
  "12": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_vae.safetensors"
    },
    "_meta": {
      "title": "Load VAE"
    }
  },
  "13": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "6",
        0
      ]
    },
    "_meta": {
      "title": "Conditioning Zero Out (cfg 1)"
    }
  },
  "16": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "2",
        0
      ],
      "vae": [
        "12",
        0
      ]
    },
    "_meta": {
      "title": "VAE Encode"
    }
  },
  "29": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "filename_prefix": "fuobe/krea2-turbo-i2i"
    },
    "_meta": {
      "title": "Save Image"
    }
  }
}
